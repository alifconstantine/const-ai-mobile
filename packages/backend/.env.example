# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:<your-deployment>

# Convex Cloud Deployment URLs
CONVEX_URL=https://<your-deployment>.convex.cloud
CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Clerk JWT Issuer Domain & Frontend API URL
CLERK_JWT_ISSUER_DOMAIN=https://<your-clerk-frontend-api>.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev


# Custom LLM / Local Endpoint (OmniRoute / OpenAI-Compatible)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
DEFAULT_ACTIVE_MODEL=Const

# LLM Providers API Keys (Optional defaults for backend agents)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
