# Const AI Monorepo Environment Variables Example

# --- Web App (apps/web/.env.local) ---
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://natural-lemming-4644.clerk.accounts.dev

# --- Backend (packages/backend/.env.local) ---
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211
CLERK_JWT_ISSUER_DOMAIN=https://natural-lemming-4644.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://natural-lemming-4644.clerk.accounts.dev

# --- LLM API Providers (Optional backend defaults) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
