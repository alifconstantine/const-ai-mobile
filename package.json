{
  "name": "const-ai-mobile-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@const-ai/web",
    "dev:mobile": "turbo dev --filter=@const-ai/mobile",
    "dev:backend": "turbo dev --filter=@const-ai/backend",
    "convex:dev": "pnpm --filter @const-ai/backend dev",
    "convex:login": "cd packages/backend && npx convex login",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "convex": "^1.19.0",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.5.2"
}
